{
  "github": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-github"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
    }
  },
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "/home/andrex/dev",
      "/home/andrex/laburo/"
    ]
  },
  "linear-server": {
    "type": "http",
    "url": "https://mcp.linear.app/mcp"
  },
  "engram": {
    "command": "engram",
    "args": [
      "mcp"
    ]
  },
  "codegraph": {
    "type": "stdio",
    "command": "codegraph",
    "args": [
      "serve",
      "--mcp"
    ]
  },
  "context7": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp"
    ],
    "env": {}
  }
}
