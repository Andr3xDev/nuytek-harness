{
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__engram__mem_capture_passive",
      "mcp__engram__mem_compare",
      "mcp__engram__mem_context",
      "mcp__engram__mem_current_project",
      "mcp__engram__mem_doctor",
      "mcp__engram__mem_get_observation",
      "mcp__engram__mem_judge",
      "mcp__engram__mem_pin",
      "mcp__engram__mem_review",
      "mcp__engram__mem_save",
      "mcp__engram__mem_save_prompt",
      "mcp__engram__mem_search",
      "mcp__engram__mem_session_end",
      "mcp__engram__mem_session_start",
      "mcp__engram__mem_session_summary",
      "mcp__engram__mem_suggest_topic_key",
      "mcp__engram__mem_unpin",
      "mcp__engram__mem_update",
      "mcp__plugin_engram_engram__mem_capture_passive",
      "mcp__plugin_engram_engram__mem_compare",
      "mcp__plugin_engram_engram__mem_context",
      "mcp__plugin_engram_engram__mem_current_project",
      "mcp__plugin_engram_engram__mem_doctor",
      "mcp__plugin_engram_engram__mem_get_observation",
      "mcp__plugin_engram_engram__mem_judge",
      "mcp__plugin_engram_engram__mem_pin",
      "mcp__plugin_engram_engram__mem_review",
      "mcp__plugin_engram_engram__mem_save",
      "mcp__plugin_engram_engram__mem_save_prompt",
      "mcp__plugin_engram_engram__mem_search",
      "mcp__plugin_engram_engram__mem_session_end",
      "mcp__plugin_engram_engram__mem_session_start",
      "mcp__plugin_engram_engram__mem_session_summary",
      "mcp__plugin_engram_engram__mem_suggest_topic_key",
      "mcp__plugin_engram_engram__mem_unpin",
      "mcp__plugin_engram_engram__mem_update",
      "mcp__github__*",
      "mcp__linear-server__*",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash"
    ],
    "deny": [
      "Bash(git push:*)",
      "Agent(cavecrew-builder)",
      "Agent(cavecrew-investigator)",
      "Agent(cavecrew-reviewer)",
      "Agent(caveman:cavecrew-builder)",
      "Agent(caveman:cavecrew-investigator)",
      "Agent(caveman:cavecrew-reviewer)"
    ],
    "ask": [
      "Bash(git stash:*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(find *-delete*)",
      "Bash(find *-exec rm*)",
      "Bash(xargs rm*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Inspect Bash command: $ARGUMENTS\n\nFlag it only if it is truly irreversible: destroying database data or schema, wiping or formatting disks, or discarding uncommitted git work (git reset --hard, git clean -f, git checkout -- <path>, git restore <path>). Everything else is reversible and must be approved: creating or editing files inside the repo (git tracks them), including via scripts, and running tests, linters or the hook self-test. Respond with JSON only: {\"ok\": true} to approve, or {\"ok\": false, \"reason\": \"<why it is irreversible>\"} to flag it for the user. Never stop the agent. git push is denied by permissions; git add, commit, rm, mv and restore --staged are denied by the agent guard hook for everyone except git-ops; git stash asks.",
            "continueOnBlock": true
          },
          {
            "type": "command",
            "command": "python3 '/home/andrex/.claude/hooks/infra-agent-bash-guard.py'",
            "timeout": 10,
            "statusMessage": "Checking infra read-only agent allow-list..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/andrex/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-verify.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /home/andrex/.claude/sounds/complete.wav"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /home/andrex/.claude/sounds/permission.wav"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size </dev/tty 2>/dev/null | awk '\"'\"'{ print $2 }'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/usr/sbin/node\" \"${plugin_dir}dist/index.js\"'"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-hud@claude-hud": true,
    "engram@engram": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "agent": "tech-orchestrator",
  "effortLevel": "medium",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
