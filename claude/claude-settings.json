      "Bash(find *-exec rm*)",
      "Bash(xargs rm*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Inspect Bash command: $ARGUMENTS\n\nFlag only truly irreversible actions: destroying database data or schema, wiping or formatting disks. Approve everything else, including file edits inside the repo, tests and linters; git discards are handled by native permission rules. Respond with JSON only: {\"ok\": true} or {\"ok\": false, \"reason\": \"<why it is irreversible>\"}.",
            "continueOnBlock": true
          },
          {
            "type": "command",
            "command": "python3 '/home/andrex/.claude/hooks/infra-agent-bash-guard.py'",
            "timeout": 10,
            "statusMessage": "Checking infra read-only agent allow-list..."
          }
        ]
      },
      {
        "matcher": "mcp__engram__mem_delete|mcp__engram__mem_merge_projects|mcp__plugin_engram_engram__mem_delete|mcp__plugin_engram_engram__mem_merge_projects",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/home/andrex/.claude/hooks/engram-tool-guard.py'",
            "timeout": 10,
            "statusMessage": "Checking engram destructive-tool access..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/andrex/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-verify.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /home/andrex/.claude/sounds/complete.wav"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /home/andrex/.claude/sounds/permission.wav"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size </dev/tty 2>/dev/null | awk '\"'\"'{ print $2 }'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $0 }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/usr/sbin/node\" \"${plugin_dir}dist/index.js\"'"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "claude-hud@claude-hud": true,
    "engram@engram": true,
    "ponytail@ponytail": true
  },
