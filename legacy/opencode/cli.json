{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": [
    "opencode-subagent-statusline",
    "subagent-statusline.tui"
  ],
  "leader": {
    "timeout": 2000
  },
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "ctrl+p"
  },
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "diffs": {
    "view": "auto",
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "mouse": true,
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
